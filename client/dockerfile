
# 1. Use Node.js as the base image
FROM node:22-bookworm-slim

# 2. Set the working directory inside the container
WORKDIR /app

# 3. Copy package files first
COPY package*.json ./

# 4. Install exact dependencies from package-lock.json
RUN npm ci

# 5. Copy the frontend source code
COPY . .

# 6. Expose Next.js port
EXPOSE 3000

# 7. Start Next.js so it is accessible outside the container
CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0"]
